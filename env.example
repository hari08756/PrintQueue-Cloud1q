# Set DNS A record for this subdomain to your VPS public IPv4 first.
SITE_DOMAIN=print.example.com
# Use unique, long random passwords. Avoid $, # and spaces to simplify Compose .env parsing.
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
OWNER_USERNAME=owner
OWNER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_OWNER_PASSWORD
